{
  "components": {
    "schemas": {
      "Animal": {
        "properties": {
          "born": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Pet ID",
            "examples": [
              7
            ],
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "cat",
              "dog"
            ],
            "type": "string"
          },
          "name": {
            "maxLength": 50,
            "type": "string"
          },
          "nicknames": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "born"
        ],
        "type": "object"
      },
      "AnimalNotFoundProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "animal_not_found"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "animal not found"
      },
      "AnimalRetiredProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "animal_retired"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "animal has retired"
      },
      "BodyTooLargeProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "body_too_large"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "request body too large"
      },
      "ErrorDetail": {
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "InternalProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "internal"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "internal error"
      },
      "MalformedRequestProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "malformed_request"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "malformed request"
      },
      "NameTakenProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "name_taken"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "another animal has this name"
      },
      "Owner": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "UnauthorizedProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "unauthorized"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "authentication required"
      },
      "UnsupportedMediaTypeProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "unsupported_media_type"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "unsupported content type"
      },
      "ValidationFailedProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "properties": {
              "code": {
                "enum": [
                  "validation_failed"
                ],
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ],
        "description": "validation failed"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "basic": {
        "scheme": "basic",
        "type": "http"
      },
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Manage pets.",
    "title": "Pet API",
    "version": "1.2.3"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Animal"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/admin/animals": {
      "post": {
        "operationId": "postAdminAnimals",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Animal"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Animal"
                }
              }
            },
            "description": "Created",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "URL of the new animal",
                "schema": {
                  "type": "string"
                }
              },
              "Warning": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "X-Count": {
                "required": true,
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              },
              "X-Since": {
                "required": true,
                "schema": {
                  "format": "date-time",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MalformedRequestProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NameTakenProblem"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/BodyTooLargeProblem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeProblem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationFailedProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearer": [
              "admin"
            ]
          },
          {
            "apiKey": []
          }
        ],
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/animals/{id}": {
      "get": {
        "operationId": "getAdminAnimalsById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Animal"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MalformedRequestProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedProblem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AnimalNotFoundProblem"
                    },
                    {
                      "$ref": "#/components/schemas/AnimalRetiredProblem"
                    }
                  ]
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationFailedProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearer": [
              "admin"
            ]
          },
          {
            "apiKey": []
          }
        ]
      }
    },
