{
    "swagger": "2.0",
    "info": {
        "title": "Pet Store",
        "contact": {},
        "version": "1.0.0"
    },
    "paths": {
        "/pets": {
            "get": {
                "summary": "List pets",
                "parameters": [
                    {
                        "enum": [
                            "cat",
                            "dog",
                            "bird"
                        ],
                        "type": "string",
                        "description": "Only pets of this kind",
                        "name": "kind",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Maximum number of pets",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Pet"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a pet",
                "parameters": [
                    {
                        "description": "Pet",
                        "name": "pet",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.PetInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.Pet"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    }
                }
            }
        },
        "/pets/{id}": {
            "get": {
                "summary": "Get a pet",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Pet ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Pet"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    }
                }
            },
            "put": {
                "summary": "Update a pet",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Pet ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Pet",
                        "name": "pet",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.PetInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Pet"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.Problem"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Pet": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "cat",
                        "dog",
                        "bird"
                    ]
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "main.PetInput": {
            "type": "object",
            "required": [
                "kind",
                "name"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "cat",
                        "dog",
                        "bird"
                    ]
                },
                "name": {
                    "type": "string",
                    "maxLength": 50
                }
            }
        },
        "main.Problem": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                }
            }
        }
    }
}